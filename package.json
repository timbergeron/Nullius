{
  "name": "nullius",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, mention-only AI bot for Discord.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "check": "node --check src/*.js && node --check public/*.js",
    "test": "node --test",
    "test:integration": "NULLIUS_NETWORK_TESTS=1 node --test test/web.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "express": "^5.2.1"
  }
}
