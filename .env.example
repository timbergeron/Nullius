PUBLIC_URL=http://localhost:3000
PORT=3000
APP_SECRET=replace-with-at-least-32-random-characters

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Optional: enables the included free trial before a server connects OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
TRIAL_ANSWER_LIMIT=20
DEFAULT_MONTHLY_LIMIT_USD=5

MAX_CONTEXT_MESSAGES=12
MAX_CONTEXT_CHARACTERS=16000
MAX_OUTPUT_TOKENS=350
USER_COOLDOWN_SECONDS=8
DATA_FILE=./data/store.json

# Knowledge packs. Set to false to switch the feature off entirely.
KNOWLEDGE_ENABLED=true
KNOWLEDGE_PACKS_DIR=./knowledge-packs
KNOWLEDGE_INDEX_DIR=./data/knowledge
KNOWLEDGE_MAX_RESULTS=12
KNOWLEDGE_MAX_CHARACTERS=16000

# Allowed source mount for the QSS-M pack. Other packs use the same
# KNOWLEDGE_SOURCE_<MOUNT_NAME> convention.
KNOWLEDGE_SOURCE_QSSM=/home/woods/codedev/QSS-M
